OPENAI_API_KEY=your_openai_api_key_here

# Optional. OpenAI model used by /api/chat. Defaults to gpt-4.1-mini when unset.
# Pin this explicitly in each Vercel environment.
OPENAI_MODEL=gpt-4.1-mini

# Optional. Set to true to stop all OpenAI calls (cost or abuse kill switch). Questions
# then receive the fixed fallback answer; crisis signposting is unaffected.
# CHAT_GENERATION_DISABLED=true
